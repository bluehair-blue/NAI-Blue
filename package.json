{
  "name": "nai-blue",
  "version": "1.3.1",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:responsive-layout": "node scripts/verify-responsive-layout-contract.mjs",
    "test:remote-runtime-removal": "node scripts/verify-remote-runtime-removal.mjs",
    "test:smart-tools": "node scripts/test-smart-tools-contract.mjs",
    "test:nai-core": "node scripts/verify-nai-core-phase.mjs",
    "test:unit": "vitest run tests/helpers",
    "test:payload-parity": "vitest run tests/payload-parity tests/fixtures/provenance.test.ts",
    "test:composition": "vitest run",
    "test:migration": "vitest run tests/migration",
    "test:diagnostics": "vitest run tests/diagnostics",
    "test:nai-transport": "vitest run tests/transport",
    "test:persistence": "vitest run tests/persistence && node scripts/verify-rescue-mode.mjs",
    "test:queue": "vitest run tests/domain/queue tests/services/queue",
    "test:sync": "vitest run tests/domain/sync tests/services/sync",
    "test:r2": "vitest run tests/domain/r2 tests/services/r2",
    "test:secret-redaction": "node scripts/verify-secret-redaction.mjs",
    "test:credential-vault": "vitest run tests/credentials",
    "test:characterization": "vitest run tests/characterization",
    "test:android-port": "node scripts/verify-android-port-contract.mjs",
    "test:android-transfer": "vitest run tests/services/android-transfer",
    "test:cloudflare-transfer": "vitest run tests/services/cloudflare-transfer && tsc -p cloudflare/nai-blue-transfer-worker/tsconfig.json",
    "qa:cloudflare-transfer:live": "node scripts/qa-cloudflare-transfer-live.mjs",
    "qa:cloudflare-transfer:rotate-live": "node scripts/rotate-cloudflare-pairing-and-qa.mjs",
    "test:release-version": "node scripts/verify-release-version.mjs",
    "qa:windows-install-registration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-install-registration.ps1",
    "test:android-idle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/track-android-idle.ps1",
    "smoke:nai-subscription": "node scripts/smoke-nai-subscription.mjs",
    "smoke:nai-endpoints": "node scripts/smoke-nai-endpoints.mjs",
    "smoke:nai-client": "vitest run tests/live/nai-client-live.test.ts",
    "smoke:nai-matrix": "vitest run tests/live/nai-online-matrix-live.test.ts",
    "tauri": "npx tauri",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build",
    "tauri:android:init": "npx tauri android init",
    "tauri:android:dev": "npx tauri android dev --host 0.0.0.0",
    "tauri:android:build:apk": "npx tauri android build --apk",
    "tauri:android:build:aab": "npx tauri android build --aab",
    "android:prepare": "node scripts/prepare-android-release.mjs",
    "test:android-release-contract": "node scripts/verify-android-release-contract.mjs",
    "test:android-release": "node scripts/verify-android-apk.mjs --mode release",
    "test:android-debug": "node scripts/verify-android-apk.mjs --mode debug",
    "release:android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-android.ps1",
    "release:android:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-android.ps1 -Publish",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:architecture": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json src",
    "test:dependencies": "knip --production --dependencies",
    "report:architecture": "depcruise --config .dependency-cruiser.cjs --output-type archi --collapse \"^src/[^/]+\" --output-to docs/architecture/import-graph.dot src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gradio/client": "^2.5.0",
    "@msgpack/msgpack": "^3.1.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "fuse.js": "^7.1.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.32.0",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/types": "^8.0.4",
    "@cloudflare/workers-types": "5.20260819.1",
    "@swc/core": "^1.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
